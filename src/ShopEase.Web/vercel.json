{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ShopEase.Web/browser",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shopease-2-rggl.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
