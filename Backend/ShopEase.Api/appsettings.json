{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShopEaseDb": ""
  },
  "Jwt": {
    "Issuer": "ShopEase.Api",
    "Audience": "ShopEase.Web",
    "SigningKey": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 14
  },
  "Cache": {
    "CatalogTtlMinutes": 5,
    "LookupTtlMinutes": 30
  },
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "PaymentGateway": {
    "SimulatedLatencyMs": 1500,
    "FailureRate": 0.05
  },
  "BackgroundJobs": {
    "BackupPollIntervalSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
